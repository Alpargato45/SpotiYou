<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".Fragments.MusicaFragment.MusicaFragment"
    android:background="@color/negroFondoApp">

    <FrameLayout
        android:id="@+id/container_second"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottom_navigation_song_artist" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation_song_artist"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@color/negroFondoApp"
        app:itemTextColor="@color/white"
        android:textAlignment="center"
        app:menu="@menu/bottom_nav_music_menu"
        android:saveEnabled="false"/>

</RelativeLayout>