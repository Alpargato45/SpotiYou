<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/logotipo_app"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/logotipo_app"
        android:supportsRtl="true"
        android:theme="@style/Theme.SpotiYou"
        android:usesCleartextTraffic="true"
        tools:targetApi="31">

        <activity
            android:name=".ActivityElegirCuenta"
            android:exported="false" />

        <activity
            android:name=".MasInformacion.Albums.ActivityInfoAlbum"
            android:exported="false" />

        <activity
            android:name=".MasInformacion.Artistas.ActivityInfoArtista"
            android:exported="false" />

        <activity
            android:name=".MasInformacion.Canciones.ActivityInfoCancion"
            android:exported="false" />

        <activity
            android:name=".ActivityPrincipal"
            android:exported="false" />

        <!-- 🔥 AQUÍ ESTÁ LO IMPORTANTE -->
        <activity
            android:name=".ConexionSpotifyApi"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:scheme="spotiyou"
                    android:host="callback" />
            </intent-filter>

        </activity>

        <activity
            android:name=".PantallaCargaInicio"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

    </application>

</manifest>